# Copy this file to .env.docker and fill in the values.
# Do NOT commit .env.docker to Git.

APP_NAME=PapaPriza
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8080
# Generate with: php artisan key:generate --show
APP_KEY=

# Admin account email (the admin logs in with this email)
ADMIN_EMAIL=admin@papapriza.local

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=papapriza
DB_USERNAME=papapriza
DB_PASSWORD=change_me
DB_ROOT_PASSWORD=change_me_root

SESSION_DRIVER=file
CACHE_STORE=file
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr
LOG_LEVEL=error
